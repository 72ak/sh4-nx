# Linux build and headless test environment for sh4-nx: gcc, SDL2, and Mesa's software OpenGL under Xvfb.
#   docker build -t sh4nx-linux -f tools/Dockerfile.linux tools
#   tools/build-linux.sh        # -> build/linux/sh4
#   tools/run-linux.sh          # runs it headless against the game folder, logs to build/linux-run.log
FROM debian:bookworm
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build libsdl2-dev xvfb mesa-utils libgl1-mesa-dri libegl1 libgl1 \
    python3 gdb && rm -rf /var/lib/apt/lists/*
ENV LIBGL_ALWAYS_SOFTWARE=1 MESA_GL_VERSION_OVERRIDE=4.3 MESA_GLSL_VERSION_OVERRIDE=430
